{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(comm *)",
      "Bash(cp *)",
      "Bash(curl *)",
      "Bash(date *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(env *)",
      "Bash(find *)",
      "Bash(for *)",
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(go list *)",
      "Bash(go mod *)",
      "Bash(go version *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(if *)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(python3 *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(test *)",
      "Bash(timeout *)",
      "Bash(tr *)",
      "Bash(wc *)",
      "Bash(while *)",
      "Read",
      "Write(artifacts/*)",
      "Edit(artifacts/*)",
      "Glob",
      "Grep",
      "Agent",
      "SendMessage",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "WebFetch",
      "WebSearch",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(apt *)",
      "Bash(pip *)",
      "Bash(npm *)",
      "Bash(git push *)",
      "Read(**/.env*)",
      "Read(**/.ssh/*)",
      "Read(**/.gnupg/*)",
      "Read(**/.config/gh/*)",
      "Read(**/.claude.json)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "trustedMcpServers": ["atlassian"],
  "skipDangerousModePermissionPrompt": true,
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  }
}
