{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "atlassian": {
      "type": "local",
      "command": ["/sandbox/.venv/bin/mcp-atlassian"],
      "enabled": true,
      "environment": {
        "READ_ONLY_MODE": "true"
      }
    },
    "gopls-mcp": {
      "type": "local",
      "command": ["/usr/local/bin/gopls", "mcp"],
      "enabled": true
    }
  }
}
