{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {"*": "deny", "bash": "allow"},
  "agent": {
    "reviewer": {
      "mode": "primary",
      "prompt": "Read /sandbox/review/skills/pr-review/SKILL.md and follow it exactly."
    }
  },
  "provider": {
    "vertex": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Vertex AI through OpenShell",
      "options": {
        "baseURL": "https://inference.local/v1",
        "apiKey": "{env:OPENCODE_VERTEX_API_KEY}"
      },
      "models": {
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro",
          "options": {"reasoningEffort": "medium"}
        }
      }
    }
  }
}
