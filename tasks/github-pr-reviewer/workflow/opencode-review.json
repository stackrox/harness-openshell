{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "*": "deny",
    "read": "allow",
    "bash": {"*": "deny", "gh api *": "allow"}
  },
  "agent": {
    "reviewer": {
      "mode": "primary",
      "prompt": "Read /sandbox/review/skills/pr-review/SKILL.md and follow it exactly."
    }
  },
  "provider": {
    "vertex": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Vertex AI through OpenShell",
      "options": {
        "baseURL": "{env:VERTEX_AI_BASE_URL}",
        "apiKey": "{env:GOOGLE_VERTEX_AI_TOKEN}"
      },
      "models": {
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro",
          "options": {"reasoningEffort": "medium"}
        }
      }
    }
  }
}
